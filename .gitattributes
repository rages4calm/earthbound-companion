* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.patch text eol=lf
# Evidence manifests bind exact file bytes, including historical line endings.
research/** -text whitespace=cr-at-eol
scripts/** -text whitespace=cr-at-eol
patches/*.patch -text
# New checkpoint receipts preserve the same bytes as their local evidence.
validation/*dev18*.json -text whitespace=cr-at-eol
