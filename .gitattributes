* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.patch text eol=lf
# Evidence manifests bind exact file bytes, including historical line endings.
research/** -text whitespace=cr-at-eol
scripts/** -text whitespace=cr-at-eol
patches/*.patch -text
# New checkpoint receipts preserve the same bytes as their local evidence.
validation/*dev18*.json -text whitespace=cr-at-eol

validation/*dev19*.json -text whitespace=cr-at-eol
scripts/party_name_parents_qa_dev19.py -text whitespace=cr-at-eol,-blank-at-eof
# Preserve vendored core hashes and patch-format blank context lines.
Achievements/Core/** text eol=lf
Achievements/earthbound* text eol=lf
patches/native-achievements.patch whitespace=-blank-at-eol,-blank-at-eof
patches/native-dialogue-camera.patch whitespace=-blank-at-eol,-blank-at-eof
patches/native-render-input.patch whitespace=-blank-at-eol,-blank-at-eof
patches/native-cinematic-option.patch whitespace=-blank-at-eol,-blank-at-eof
patches/native-psi-label.patch whitespace=-blank-at-eol,-blank-at-eof
patches/native-paula-receipt.patch whitespace=-blank-at-eol,-blank-at-eof

patches/native-threed-npc-restoration.patch whitespace=-blank-at-eol,-blank-at-eof
