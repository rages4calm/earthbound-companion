<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>EarthBound Companion</AssemblyName><Version>1.0.15</Version>
    <InformationalVersion>1.0.15</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\earthbound-companion.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="randomizer-layout.json" /><EmbeddedResource Include="progression-policy*.json" /><EmbeddedResource Include="..\research\msu-manifest.json" Link="msu-manifest.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\earthbound-companion.ico" LogicalName="EarthBoundCompanion.AppIcon" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="..\Achievements\earthbound.json" LogicalName="EarthBoundCompanion.AchievementCatalog" /></ItemGroup>
</Project>
