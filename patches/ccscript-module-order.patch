diff --git a/src/compiler.cpp b/src/compiler.cpp
index c433f60..351a137 100644
--- a/src/compiler.cpp
+++ b/src/compiler.cpp
@@ -363,7 +363,37 @@ void Compiler::AssignModuleAddresses()
 	// module that will fit, we increase the base address to the start of the next bank.
 
 	vector<Module*> sorted = modules;
-	std::sort(sorted.begin(), sorted.end(), module_pred);
+	if(module_order_file.empty()) {
+		std::sort(sorted.begin(), sorted.end(), module_pred);
+	} else {
+		// The legacy size-only sort leaves ties to the C++ library. A checked
+		// layout makes an audited project reproducible across toolchains.
+		ifstream orderfile(util::ConvertToNativeString(module_order_file));
+		if(!orderfile) throw Exception("cannot read module order file");
+		map<string, pair<unsigned int, unsigned int> > order;
+		string name;
+		unsigned int size;
+		while(orderfile >> name >> size) {
+			if(!size || order.count(name)) throw Exception("invalid module order entry");
+			order[name] = make_pair(static_cast<unsigned int>(order.size()), size);
+		}
+		if(!orderfile.eof()) throw Exception("invalid module order file");
+		unsigned int count = 0;
+		for(Module* m : modules) {
+			if(!m->GetCodeSize()) continue;
+			auto entry = order.find(m->GetName());
+			if(entry == order.end() || entry->second.second != m->GetCodeSize())
+				throw Exception("module order size/name mismatch: " + m->GetName());
+			++count;
+		}
+		if(count != order.size()) throw Exception("module order contains unknown modules");
+		std::sort(sorted.begin(), sorted.end(), [&order](Module* a, Module* b) {
+			if(a->GetCodeSize() != b->GetCodeSize())
+				return a->GetCodeSize() > b->GetCodeSize();
+			if(!a->GetCodeSize()) return a->GetName() < b->GetName();
+			return order.at(a->GetName()).first < order.at(b->GetName()).first;
+		});
+	}
 	unsigned int base = this->outadr;
 
 	totalfrag = 0;
