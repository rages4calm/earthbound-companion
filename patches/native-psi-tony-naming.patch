+/* Resolve shared frame pointers for drawing and fade copies. The pinned Redux
+ * Tony running group repeats one west frame; mirror its two east frames instead.
+ * Check the descriptor itself so corrected/custom groups remain untouched. */
+uint16_t sprite_frame_pointer(uint32_t offset) {
+    if (offset + 2 > sprite_grouping_data_size) return 0;
+    if (maternalbound_enabled() && sprite_grouping_ptr_count > 476) {
+        uint32_t base = (read_u32_le(sprite_grouping_ptr_table + 476 * 4) & 0xFFFF) - 0x1A7F;
+        /* Translate the ROM pointer using the grouping buffer base. */
+        if (base + 41 <= sprite_grouping_data_size &&
+            (offset == base + 21 || offset == base + 23) &&
+            read_u16_le(sprite_grouping_data_buf + base + 21) == 0x90C0 &&
+            read_u16_le(sprite_grouping_data_buf + base + 23) == 0x90C0 &&
+            read_u16_le(sprite_grouping_data_buf + base + 13) == 0x8E80 &&
+            read_u16_le(sprite_grouping_data_buf + base + 15) == 0x8F40)
+            return read_u16_le(sprite_grouping_data_buf + offset - 8) ^ 1;
+    }
+    return read_u16_le(sprite_grouping_data_buf + offset);
+}
 
