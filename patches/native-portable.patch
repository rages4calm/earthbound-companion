@@ -0,0 +1,11 @@
+cmake_minimum_required(VERSION 3.22)
+project(EarthBoundAndroid C)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(SDL_SHARED ON CACHE BOOL "" FORCE)
+set(SDL_STATIC OFF CACHE BOOL "" FORCE)
+set(SDL_TEST OFF CACHE BOOL "" FORCE)
+if(NOT EB_SDL_SOURCE)
+ message(FATAL_ERROR "Provide the checksum-verified SDL source path")
+endif()
+add_subdirectory(${EB_SDL_SOURCE} ${CMAKE_CURRENT_BINARY_DIR}/SDL)
+add_subdirectory(../unix ${CMAKE_CURRENT_BINARY_DIR}/earthbound)
diff --git a/port/unix/platform/sdl2_mobile.c b/port/unix/platform/sdl2_mobile.c
new file mode 100644
--- /dev/null
+++ b/port/unix/platform/sdl2_mobile.c
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifdef __ANDROID__
+#include <SDL.h>
+#include <jni.h>
+#include "sdl2_mobile.h"
+static SDL_atomic_t touch_actions[21];
+bool pc_mobile_held(int action) {return action >= 0 && action < 21 && SDL_AtomicGet(&touch_actions[action]) > 0;}
+void pc_mobile_clear(void) {for(int i=0;i<21;i++)SDL_AtomicSet(&touch_actions[i],0);}
+void pc_mobile_open_settings(void) {
+ JNIEnv *env=SDL_AndroidGetJNIEnv();jobject activity=SDL_AndroidGetActivity();
+ if(!env||!activity)return;
+ jclass type=(*env)->GetObjectClass(env,activity);
+ jmethodID method=(*env)->GetMethodID(env,type,"openSettings","()V");
+ if(method)(*env)->CallVoidMethod(env,activity,method);
+ (*env)->DeleteLocalRef(env,type);(*env)->DeleteLocalRef(env,activity);
+}
+JNIEXPORT void JNICALL Java_org_earthbound_companion_GameActivity_setTouch(JNIEnv *env, jclass type, jint action, jboolean down) {
+ (void)env; (void)type;
+ if (action < 0 || action >= 21) return;
+ int previous, next;
+ do {previous=SDL_AtomicGet(&touch_actions[action]); next=down ? previous+1 : (previous>0 ? previous-1 : 0);}
+ while (!SDL_AtomicCAS(&touch_actions[action],previous,next));
+}
+JNIEXPORT void JNICALL Java_org_earthbound_companion_GameActivity_clearTouch(JNIEnv *env, jclass type) {(void)env;(void)type;pc_mobile_clear();}
+#endif
+
+#ifdef __ANDROID__
+JNIEXPORT void JNICALL Java_org_earthbound_companion_GameActivity_requestQuit(JNIEnv *env,jclass type) {(void)env;(void)type;SDL_Event event;SDL_zero(event);event.type=SDL_QUIT;SDL_PushEvent(&event);}
+#endif
