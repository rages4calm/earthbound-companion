+/* Pinned data_54.ccs: Carpainter's no-badge refusal ends one byte before
+ * the Yes branch. The Yes branch alone has the post-warp pause/close tail.
+ * Reuse that exact tail for No as well. Resolve labels from the pack and check
+ * the suffix rather than changing asset bytes, pack identity or save cursors. */
+uint32_t maternalbound_carpainter_refusal_cleanup(uint32_t after_end_offset) {
+    static const uint8_t tail[] = {
+        0x10,0x91, /* pause(145), same timing as the Yes branch */
+        0x1A,0x0C,0x0D,0x00,0x00,0x00, /* typed cc_close_letterbox */
+        0x02
+    };
+    if (!redux_blob) return 0;
+    uint32_t no = maternalbound_resolve_entry(0xC980C1u);
+    uint32_t yes = maternalbound_resolve_entry(0xC98148u);
+    uint32_t after = maternalbound_resolve_entry(0xC9817Au);
+    if (no < MATERNALBOUND_DIALOGUE_BASE || yes <= no || after <= yes) return 0;
+    uint32_t yes_offset = yes-0x100000u, end = after-0x100000u;
+    if (after_end_offset != yes_offset || end > redux_map_offset ||
+        end-yes_offset < sizeof(tail) || redux_blob[yes_offset-1] != 0x02 ||
+        memcmp(redux_blob+end-sizeof(tail),tail,sizeof(tail))) return 0;
+    return after-sizeof(tail);
+}
