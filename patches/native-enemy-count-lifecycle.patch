         ow.overworld_enemy_count--;
     }
 
@@ -2300,6 +2303,15 @@
 }
 
 void overworld_savestate_rebind(void) {
+    /* Older quick saves can contain an underflowed enemy count after a door.
+     * Recover from live entities instead of preserving a permanent spawn lock. */
+    if (ow.overworld_enemy_count > MAX_ENTITIES) {
+        ow.overworld_enemy_count = 0;
+        for (int i = 0; i < MAX_ENTITIES; i++)
+            if (entities.script_table[i] >= 0 &&
+                (entities.npc_ids[i] & 0xF000) == 0x8000)
+                ow.overworld_enemy_count++;
+    }
     ow.post_teleport_callback =
         (ow.post_teleport_callback_id == POST_TELEPORT_CB_UNDRAW_FLYOVER_TEXT)
             ? undraw_flyover_text : NULL;
