+/* Source: essential/cc_effects.ccs. The opening loop renders 0,3,...,39;
+ * the closing loop renders 39,36,...,3 and then disables HDMA. */
+void maternalbound_letterbox_start(uint8_t routine) {
+    ow.redux_letterbox_active = 1;
+    ow.redux_letterbox_direction = routine == 11 ? 1 : routine == 13 ? 2 : 0;
+    ow.redux_letterbox_top = routine == 11 ? 0 : routine == 13 ? 39 : 40;
+}
+
+void maternalbound_effects_tick(void) {
+    if (!maternalbound_enabled() || !ow.redux_letterbox_active) return;
+    if (ow.redux_letterbox_direction == 2 && !ow.redux_letterbox_top) {
+        ow.redux_letterbox_active = 0; ow.redux_letterbox_direction = 0;
+        ppu.tm_hdma_active = false;
+        return;
+    }
+    bt.letterbox_top_end = ow.redux_letterbox_top;
+    bt.letterbox_bottom_start = 224-ow.redux_letterbox_top;
+    bt.letterbox_nonvisible_screen_value = 4; /* BG3, the black bars */
+    bt.letterbox_visible_screen_value = 23; /* BG1/BG2/BG3/objects */
+    build_letterbox_hdma_table();
+    apply_letterbox_to_ppu();
+    if (ow.redux_letterbox_direction == 1) {
+        if (ow.redux_letterbox_top < 39) ow.redux_letterbox_top += 3;
+        else ow.redux_letterbox_direction = 0;
+    } else if (ow.redux_letterbox_direction == 2) {
+        if (ow.redux_letterbox_top > 3) ow.redux_letterbox_top -= 3;
+        else ow.redux_letterbox_top = 0; /* Disable only after the frame at 3 was rendered. */
+    }
+}
