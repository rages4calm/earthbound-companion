diff --git a/src/platform/pc_options.c b/src/platform/pc_options.c
new file mode 100644
index 0000000..2d5f45c
--- /dev/null
+++ b/src/platform/pc_options.c
@@ -0,0 +1,103 @@
+#include "platform/pc_options.h"
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+PcOptions pc_options;
+_Atomic bool pc_paused;
+const char *pc_config_path = "earthbound.ini";
+const char *pc_input_script_path;
+void pc_options_defaults(void) {
+    memset(&pc_options, 0, sizeof(pc_options));
+    pc_options.width = 1920;
+    pc_options.height = 1080;
+    pc_options.integer_scale = 1;
+    pc_options.volume = 80;
+    pc_options.music_volume = 75;
+    pc_options.exp_multiplier = 1;
+    pc_options.money_multiplier = 1;
+    pc_options.deadzone = 8000;
+    const int keys[PC_ACTIONS] = {40, 29, 22, 225, 27, 26, 40, 229, 82, 81, 80,
+                                  79, 43, 63, 64,  68, 66, 69, 60,  58, 6};
+    const int buttons[PC_ACTIONS] = {6,  1,  3,  2,  0,  10, 6,  4,  11, 12, 13,
+                                     14, -1, -1, -1, -1, -1, -1, -1, -1, 8};
+    memcpy(pc_options.keys, keys, sizeof(keys));
+    memcpy(pc_options.buttons, buttons, sizeof(buttons));
+    strcpy(pc_options.msu_dir, "msu");
+}
+static char *trim(char *s) {
+    while (isspace((unsigned char)*s))
+        ++s;
+    size_t n = strlen(s);
+    while (n && isspace((unsigned char)s[n - 1]))
+        s[--n] = 0;
+    return s;
+}
+static int integer(const char *s, int fallback, int lo, int hi) {
+    char *end;
+    long v = strtol(s, &end, 10);
+    if (end == s || *trim(end) || v < lo || v > hi)
+        return fallback;
+    return (int)v;
+}
+bool pc_options_load(const char *path) {
+    FILE *f = fopen(path, "rb");
+    if (!f)
+        return false;
+    char line[2048];
+    while (fgets(line, sizeof(line), f)) {
+        char *s = trim(line);
+        if (*s == '#' || *s == ';' || *s == '[' || !*s)
+            continue;
+        char *equal = strchr(s, '=');
+        if (!equal)
+            continue;
+        *equal = 0;
+        char *key = trim(s), *value = trim(equal + 1);
+        struct Number {
+            const char *name;
+            int *field;
+            int lo, hi;
+        };
+        const struct Number numbers[] = {{"companion", &pc_options.companion, 0, 1},
+                                         {"width", &pc_options.width, 640, 7680},
+                                         {"height", &pc_options.height, 480, 4320},
+                                         {"fullscreen", &pc_options.fullscreen, 0, 1},
+                                         {"integer_scale", &pc_options.integer_scale, 0, 1},
+                                         {"filter", &pc_options.filter, 0, 2},
+                                         {"instant_text", &pc_options.instant_text, 0, 1},
+                                         {"no_homesickness", &pc_options.no_homesickness, 0, 1},
+                                         {"no_dad_calls", &pc_options.no_dad_calls, 0, 1},
+                                         {"exp_multiplier", &pc_options.exp_multiplier, 1, 4},
+                                         {"money_multiplier", &pc_options.money_multiplier, 1, 4},
+                                         {"quick_slot", &pc_options.quick_slot, 0, 4},
+                                         {"deadzone", &pc_options.deadzone, 2000, 30000}};
+        bool found = false;
+        for (size_t i = 0; i < sizeof(numbers) / sizeof(numbers[0]); i++)
+            if (!strcmp(key, numbers[i].name)) {
+                *numbers[i].field = integer(value, *numbers[i].field, numbers[i].lo, numbers[i].hi);
+                found = true;
+                break;
+            }
+        if (found)
+            continue;
+        if (!strcmp(key, "volume"))
+            pc_options.volume = integer(value, pc_options.volume, 0, 100);
+        else if (!strcmp(key, "music_volume"))
+            pc_options.music_volume = integer(value, pc_options.music_volume, 0, 100);
+        else if (!strcmp(key, "msu_dir"))
+            snprintf(pc_options.msu_dir, sizeof(pc_options.msu_dir), "%s", value);
+        else if (!strncmp(key, "key.", 4)) {
+            int i = integer(key + 4, -1, 0, PC_ACTIONS - 1);
+            if (i >= 0)
+                pc_options.keys[i] = integer(value, pc_options.keys[i], 0, 511);
+        } else if (!strncmp(key, "button.", 7)) {
+            int i = integer(key + 7, -1, 0, PC_ACTIONS - 1);
+            if (i >= 0)
+                pc_options.buttons[i] = integer(value, pc_options.buttons[i], -1, 16);
+        }
+    }
+    bool ok = !ferror(f);
+    fclose(f);
+    return ok;
+}
