+bool maternalbound_battle_tools_selftest(void) {
+    if(!maternalbound_enabled()) return false;
+    memset(&bt,0,sizeof(bt));
+    memset(party_characters,0,sizeof(CharStruct)*TOTAL_PARTY_COUNT);
+    memset(event_flags,0,EVENT_FLAG_COUNT/8);
+    BattleMenuState state={0};state.char_id=3;
+    if(!redux_battle_tool_available(0,&state)) return false;
+    for(unsigned i=1;i<11;i++) {
+        if(redux_battle_tool_available(i,&state)) return false;
+        event_flag_set(redux_battle_tools[i].flag);
+        if(!redux_battle_tool_available(i,&state)) return false;
+    }
+    event_flag_set(142);
+    if(redux_battle_tool_available(10,&state)) return false;
+    event_flag_clear(142);
+    CharStruct *jeff=&party_characters[2];
+    for(unsigned group=0;group<2;group++) {
+        unsigned index=group?STATUS_GROUP_TEMPORARY:STATUS_GROUP_PERSISTENT_EASYHEAL;
+        jeff->afflictions[index]=group?STATUS_2_IMMOBILIZED:STATUS_0_PARALYZED;
+        for(unsigned i=0;i<11;i++) if(redux_battle_tool_available(i,&state)!=(i==0)) return false;
+        jeff->afflictions[index]=0;
+    }
+    Battler *b=&bt.battlers_table[2];b->id=3;b->consciousness=1;
+    for(unsigned i=0;i<11;i++) {
+        bt.battle_menu_param1=0;
+        bt.battle_item_used=redux_battle_tools[i].item;
+        bt.battle_menu_targetting=redux_battle_tools[i].target;
+        bt.battle_menu_selected_target=redux_battle_tools[i].target==17 ? 9 : redux_battle_tools[i].target;
+        btl_store_action(3,redux_battle_tools[i].action);
+        if(b->current_action!=redux_battle_tools[i].action ||
+           b->current_action_argument!=redux_battle_tools[i].item || b->action_item_slot!=0 ||
+           b->action_targetting!=redux_battle_tools[i].target ||
+           b->current_target!=bt.battle_menu_selected_target) return false;
+    }
+    fprintf(stderr,"Redux battle Tools: 11 flag devices, maid handoff, paralysis/immobilization and inventory-free action arguments, PASS\n");
+    return true;
+}
