+bool pc_msu_pack_selftest(void) {
+    if (!msu_pack_loaded) return false;
+    unsigned covered=0,missing=0,loops=0,one_shots=0;
+    bool ok=true;
+    for (unsigned track=1;track<=191;track++) {
+        char path[1100];
+        snprintf(path,sizeof(path),"%s/%s-%u.pcm",msu_dir,msu_name,track);
+        FILE *f=fopen(path,"rb");
+        bool expected=f!=NULL;
+        if(f) fclose(f);
+        platform_audio_msu_stop();
+        bool played=platform_audio_msu_play((uint16_t)track);
+        ok &= played==expected;
+        if(!played) {missing++;continue;}
+        covered++;
+        int16_t samples[128]={0};
+        /* Finish the real file's tail at the output device's 32 kHz rate. */
+        bool repeats=msu_repeats;
+        SDL_LockMutex(msu_mutex);
+        msu_read_pos=msu_total_frames-1;
+        SDL_UnlockMutex(msu_mutex);
+        platform_audio_msu_mix(samples,64,32000);
+        if(repeats) {
+            loops++;
+            ok &= msu_active && msu_read_pos>=msu_loop_frame &&
+                  msu_read_pos<msu_total_frames;
+        } else {
+            one_shots++;
+            ok &= !msu_active;
+        }
+    }
+    platform_audio_msu_stop();
+    ok &= covered==164 && covered+missing==191;
+    fprintf(stderr,"MSU installed pack: %u tracks, %u loop boundaries, %u one-shot ends, %u missing fallbacks, %s\n",covered,loops,one_shots,missing,ok?"PASS":"FAIL");
+    return ok;
+}
