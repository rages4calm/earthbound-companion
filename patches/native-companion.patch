+bool pc_msu_selftest(void) {
+    char *dir = SDL_GetPrefPath("EarthBoundCompanion", "MsuTests");
+    if (!dir)
+        return false;
+    unsigned char data[24] = {'M', 'S', 'U', '1', 1,  0,  0,  0,  16, 39, 16, 39,
+                              16,  39,  16,  39,  16, 39, 16, 39, 16, 39, 16, 39};
+    char path[1024];
+    for (int t = 1; t <= 4; t++) {
+        snprintf(path, sizeof(path), "%stest-%d.pcm", dir, t);
+        FILE *f = fopen(path, "wb");
+        if (!f) {
+            SDL_free(dir);
+            return false;
+        }
+        if (t == 3)
+            data[4] = 90;
+        if (t == 4)
+            data[0] = 'X';
+        fwrite(data, 1, t == 4 ? 9 : sizeof(data), f);
+        fclose(f);
+    }
+    pc_options_defaults();
+    pc_options.music_volume = 100;
+    platform_audio_msu_load(dir, "test");
+    int16_t out[32] = {0};
+    bool ok = platform_audio_msu_play(1);
+    platform_audio_msu_mix(out, 16, 44100);
+    ok = ok && !msu_active && out[0] == 10000 && out[8] == 0;
+    memset(out, 0, sizeof(out));
+    ok = ok && platform_audio_msu_play(2);
+    platform_audio_msu_mix(out, 16, 32000);
+    ok = ok && msu_active && out[30] == 10000;
+    pc_msu_command(2);
+    int16_t fading[64000] = {0};
+    platform_audio_msu_mix(fading, 32000, 32000);
+    ok = ok && msu_gain < 0.1;
+    ok = ok && !platform_audio_msu_play(3) && !platform_audio_msu_play(4) &&
+         !platform_audio_msu_play(65535);
+    platform_audio_msu_stop();
+    for (int t = 1; t <= 4; t++) {
+        snprintf(path, sizeof(path), "%stest-%d.pcm", dir, t);
+        remove(path);
+    }
+    SDL_free(dir);
+    SDL_DestroyMutex(msu_mutex);
+    msu_mutex = NULL;
+    msu_pack_loaded = false;
+    fprintf(stderr,
+            "MSU one-shot / loop-point / resample / fade / invalid-header / missing-track: %s\n",
+            ok ? "PASS" : "FAIL");
