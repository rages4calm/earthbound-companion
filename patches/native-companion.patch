+        bool played=platform_audio_msu_play((uint16_t)track);
+        ok &= played==expected;
+        if(!played) {missing++;continue;}
+        covered++;
+        int16_t samples[128]={0};
+        /* Finish the real file's tail at the output device's 32 kHz rate. */
+        bool repeats=msu_repeats;
+        SDL_LockMutex(msu_mutex);
+        msu_read_pos=msu_total_frames-1;
+        SDL_UnlockMutex(msu_mutex);
