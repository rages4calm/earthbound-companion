+        !maternalbound_window_config(72,geometry) || geometry[2]!=6 || geometry[3]!=6 ||
+        maternalbound_window_config(WINDOW_SETTINGS_MENU,geometry)) return false;
+    fprintf(stderr,"Redux production equipment: %u item/character previews preserve gear and match committed stats, Teddy-bear identity and window remapping, PASS\n",tests);
+    return tests>0;
