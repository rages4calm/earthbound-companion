diff --git a/ebtools/parsers/original_movement_banks.py b/ebtools/parsers/original_movement_banks.py
new file mode 100644
index 0000000..62cfa40
--- /dev/null
+++ b/ebtools/parsers/original_movement_banks.py
@@ -0,0 +1,60 @@
+"""Keep Original movement bytecode from discontiguous donor-ROM regions.
+
+The existing C3 asset key remains unchanged. Only this local container header
+and ROM addresses are code; all movement bytecode comes from the user's ROM.
+"""
+
+import struct
+
+MAGIC = b"EBMVBN01"
+C3_ROM_SIZE = 0xE012
+GHOST_ADDRESS = 0xC0AD8A
+GHOST_SIZE = 21
+POINTER_TABLE_OFFSET = 0x400D4
+GHOST_SCRIPT_ID = 786
+
+
+def encode_original_movement_banks(c3: bytes, ghost: bytes) -> bytes:
+    if not c3 or len(c3) > 0x10000 or len(ghost) != GHOST_SIZE:
+        raise ValueError("Invalid Original movement region lengths")
+    output = bytearray(struct.pack("<8sI", MAGIC, 2))
+    for bank, base, data in ((0xC3, 0, c3), (0xC0, GHOST_ADDRESS & 0xFFFF, ghost)):
+        output.extend(struct.pack("<BBHI", bank, 0, base, len(data)))
+        output.extend(data)
+    return bytes(output)
+
+
+def decode_original_movement_banks(data: bytes) -> tuple[bytes, bytes] | None:
+    """Return C3/ghost regions, or None for the legacy naked C3 format."""
+    if not data.startswith(MAGIC):
+        return None
+    if len(data) < 12 or struct.unpack_from("<I", data, 8)[0] != 2:
+        raise ValueError("Invalid Original movement container header")
+    offset = 12
+    regions = []
+    for expected_bank, expected_base in ((0xC3, 0), (0xC0, GHOST_ADDRESS & 0xFFFF)):
+        if offset + 8 > len(data):
+            raise ValueError("Truncated Original movement region header")
+        bank, reserved, base, size = struct.unpack_from("<BBHI", data, offset)
+        offset += 8
+        if (bank, reserved, base) != (expected_bank, 0, expected_base) or not size or size > 0x10000 - base:
+            raise ValueError("Invalid Original movement region bounds")
+        if offset + size > len(data):
+            raise ValueError("Truncated Original movement region data")
+        regions.append(data[offset : offset + size])
+        offset += size
+    if offset != len(data) or len(regions[1]) != GHOST_SIZE:
+        raise ValueError("Invalid Original movement container tail")
+    return regions[0], regions[1]
+
+
+def extract_original_movement_banks(c3: bytes, rom: bytes) -> bytes:
+    """Extract EVENT786 using the verified USA donor pointer-table layout."""
+    pointer_offset = POINTER_TABLE_OFFSET + GHOST_SCRIPT_ID * 3
+    if len(c3) != C3_ROM_SIZE or len(rom) != 0x300000:
+        raise ValueError("Unexpected Original movement extraction layout")
+    address = int.from_bytes(rom[pointer_offset : pointer_offset + 3], "little")
+    if address != GHOST_ADDRESS:
+        raise ValueError("Original mini-ghost pointer differs from the supported USA layout")
+    offset = address - 0xC00000
+    return encode_original_movement_banks(c3, rom[offset : offset + GHOST_SIZE])
