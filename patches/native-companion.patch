+bool pc_msu_pack_selftest(void) {
+    if (!msu_pack_loaded) return false;
+    unsigned covered=0,missing=0,loops=0,one_shots=0;
+    bool ok=true;
+    for (unsigned track=1;track<=191;track++) {
