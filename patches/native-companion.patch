+static const uint8_t *redux_blob;
+static uint32_t redux_map_offset, redux_map_count, redux_determiner_offset, redux_determiner_size;
+
+static uint32_t redux_u32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+uint32_t maternalbound_enemy_ai_entry(uint16_t enemy) {
+    if (!maternalbound_enabled()) return 0;
+    const uint8_t *table = ASSET_DATA(ASSET_DATA_ENEMY_CONFIGURATION_TABLE_BIN);
+    size_t size = ASSET_SIZE(ASSET_DATA_ENEMY_CONFIGURATION_TABLE_BIN);
+    const size_t records = 231, offset = records*sizeof(EnemyData);
+    if (!table || size != offset+12+records*4 ||
+        memcmp(table+offset,"MRDXAI01",8) || read_u32_le(table+offset+8) != records)
+        FATAL("Redux: invalid native enemy AI table\n");
+    return enemy < records ? read_u32_le(table+offset+12+enemy*4) : 0;
+}
+
+uint16_t maternalbound_sprite_variant(unsigned character,unsigned mode,bool running,bool alternate) {
+    const uint8_t *data=ASSET_DATA(ASSET_DATA_PLAYABLE_CHARACTER_GRAPHICS_TABLE_BIN);
+    size_t size=ASSET_SIZE(ASSET_DATA_PLAYABLE_CHARACTER_GRAPHICS_TABLE_BIN);
+    if (character>=17 || mode>=8 || !maternalbound_enabled()) return 0xFFFF;
+    if (!data || size!=272+8+3*272 || memcmp(data+272,"MRWALK01",8))
+        FATAL("Redux: invalid native walking animation tables\n");
+    unsigned variant=running ? (alternate ? 3 : 2) : (alternate ? 1 : 0);
+    size_t base=variant ? 280+(variant-1)*272 : 0;
+    return read_u16_le(data+base+(character*8+mode)*2);
+}
+
+bool maternalbound_bind_dialogue(const uint8_t *blob, size_t size) {
+    redux_blob = NULL;
+    if (!blob) return false;
+    if (size < 32 || memcmp(blob + size - 32, "MRDXNV01", 8))
+        return size < MATERNALBOUND_DIALOGUE_BASE-0x100000u;
+    const uint8_t *footer = blob + size - 32;
+    uint32_t version = redux_u32(footer + 8);
+    uint32_t map = redux_u32(footer + 12), count = redux_u32(footer + 16);
+    uint32_t determiners = redux_u32(footer + 20), determiner_size = redux_u32(footer + 24);
+    uint32_t dialogue_end = redux_u32(footer + 28);
+    if (version != 1 || !count || count > 10000 || map > size-32 || (uint64_t)map + count*8u > size-32 ||
+        determiners > size-32 || (uint64_t)determiners + determiner_size > size-32 ||
+        dialogue_end < MATERNALBOUND_DIALOGUE_BASE-0x100000u || dialogue_end != map || determiner_size != 254 ||
+        (uint64_t)map + count*8u != determiners || (uint64_t)determiners + determiner_size != size-32)
+        return false;
+    uint32_t previous = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t source = redux_u32(blob + map + i*8u);
+        uint32_t target = redux_u32(blob + map + i*8u + 4);
+        if (source < 0x100000u || source >= MATERNALBOUND_DIALOGUE_BASE || source <= previous ||
+            target < MATERNALBOUND_DIALOGUE_BASE || target-0x100000u >= dialogue_end) return false;
+        previous = source;
+    }
+    for (uint32_t i = 0; i < determiner_size; ++i)
+        if (blob[determiners+i] < 1 || blob[determiners+i] > 5) return false;
+    redux_blob = blob; redux_map_offset = map; redux_map_count = count;
+    redux_determiner_offset = determiners; redux_determiner_size = determiner_size;
+    return true;
+}
