diff --git a/src/game/maternalbound_battle_sprites.c b/src/game/maternalbound_battle_sprites.c
new file mode 100644
index 0000000..c0deb17
--- /dev/null
+++ b/src/game/maternalbound_battle_sprites.c
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Native adaptation of m3sprites.ccs by ShadowOne333/contributors and
+ * Bowspr by cooprocks123e. The native compositor uses the normalized sprite
+ * data directly, avoiding SNES VRAM and shared-palette allocation limits.
+ */
+#include "game/maternalbound_battle_sprites.h"
+#include "game/maternalbound.h"
+#include "game/battle.h"
+#include "game/game_state.h"
+#include "game/window.h"
+#include "entity/sprite.h"
+#include "data/assets.h"
+#include "include/binary.h"
+#include "core/log.h"
+#include <stdio.h>
+#include <string.h>
+
+MaternalboundBattleSprites maternalbound_battle_sprites;
+
+/* Redux before_battle_hj clears m3sbs before each battle. Old/cold states
+ * must not rely on an intervening overworld fade clearing victory state. */
+void maternalbound_battle_sprites_reset(void) {
+    memset(&maternalbound_battle_sprites,0,sizeof(maternalbound_battle_sprites));
+}
+
+/* BowsprEnd disables the compositor across a yielded cutscene until a
+ * matching m3sbs_init. Keep this in the existing serialized active byte:
+ * old checkpoints still use 0 (uninitialized) or 1 (active), 2 is suspended. */
+void maternalbound_battle_sprites_suspend(void) {
+    maternalbound_battle_sprites_reset();
+    maternalbound_battle_sprites.active=2;
+}
+
+static uint16_t character_group(unsigned character) {
+    static const uint16_t robots[]={5,343,355,457};
+    if(character<1 || character>4) return 0;
+    if(game_state.character_mode==CHARACTER_MODE_ROBOT || bt.giygas_phase) return robots[character-1];
+    if(character==1 && game_state.character_mode==CHARACTER_MODE_GHOST) return 6;
+    return (uint16_t)character;
+}
+
+void maternalbound_battle_sprites_tick(void) {
+    MaternalboundBattleSprites *s=&maternalbound_battle_sprites;
+    if(!maternalbound_enabled() || !bt.battle_mode_flag) { maternalbound_battle_sprites_reset(); return; }
+    if(s->active==2) return;
+    if(!s->active) {
+        memset(s,0,sizeof(*s)); s->active=1;
+        for(unsigned i=0;i<4;i++) s->anchor_y[i]=168;
+    }
+    s->target_mask=0;
+    for(unsigned i=0;i<4;i++) {
+        Battler *b=&bt.battlers_table[i];
+        if(!character_group(b->id)) continue;
+        bool wanted=s->victory?(b->consciousness && b->afflictions[0]!=1 && b->afflictions[0]!=2):win.battle_menu_current_character_id==(int)i;
+        if(wanted) s->target_mask|=(uint8_t)(1u<<i);
+        if(wanted) {
+            s->visible_mask|=(uint8_t)(1u<<i);
+            if(s->anchor_y[i]>152) s->anchor_y[i]-=2;
+        } else {
+            if(s->anchor_y[i]<168) s->anchor_y[i]+=2;
+            if(s->anchor_y[i]>=168) s->visible_mask&=(uint8_t)~(1u<<i);
+        }
+    }
+}
+
+void maternalbound_battle_sprites_victory(void) {
+    if(maternalbound_enabled()) maternalbound_battle_sprites.victory=1;
+}
+
+bool maternalbound_battle_sprites_visible(void) {
+    return maternalbound_enabled() && bt.battle_mode_flag && maternalbound_battle_sprites.active==1;
+}
+
+static const uint8_t *group_frame(uint16_t group,unsigned *width,unsigned *height,
+                                  unsigned *palette,bool *flip) {
+    if(!sprite_grouping_ptr_table || group>=sprite_grouping_ptr_count) return NULL;
+    uint32_t offset=(read_u32_le(sprite_grouping_ptr_table+group*4)&0xFFFF)-0x1A7F;
+    if(offset>sprite_grouping_data_size || sprite_grouping_data_size-offset<19) return NULL;
+    const uint8_t *sg=sprite_grouping_data_buf+offset;
+    *width=sg[1]>>4; *height=sg[0]; *palette=(sg[3]>>1)&7;
+    if(!*width || *width>4 || !*height || *height>8) return NULL;
+    /* Facing down, animation zero: direction 4 maps to frame-table pair 2. */
+    uint16_t address=read_u16_le(sg+9+8); *flip=(address&1)!=0; address&=0xFFFC;
+    int bank=(sg[8]&0x3F)-SPRITE_BANK_FIRST;
+    unsigned bytes=(*width)*(*height)*32;
+    if(bank<0 || bank>=SPRITE_BANK_COUNT || !sprite_banks[bank] ||
+       address>sprite_bank_sizes[bank] || bytes>sprite_bank_sizes[bank]-address) return NULL;
+    return sprite_banks[bank]+address;
+}
+
+bool maternalbound_battle_sprites_line(int y,uint16_t *colour,uint8_t *priority,int width) {
+    if(!maternalbound_battle_sprites_visible()) return false;
+    static const int positions[]={45,78,101,133,157,189,213};
+    unsigned count=game_state.player_controlled_party_count;
+    if(count<1 || count>4) return false;
+    bool wrote=false;
+    for(unsigned i=0;i<4;i++) {
+        if(!(maternalbound_battle_sprites.visible_mask&(1u<<i))) continue;
+        uint16_t group=character_group(bt.battlers_table[i].id);
+        unsigned wt,ht,pal; bool flip;
+        const uint8_t *frame=group_frame(group,&wt,&ht,&pal,&flip);
+        if(!frame) FATAL("Redux battle party sprite %u is unavailable\n",group);
+        int row=y-EB_VIEWPORT_PAD_TOP-(maternalbound_battle_sprites.anchor_y[i]-(int)ht*8);
+        if(row<0 || row>=(int)ht*8) continue;
+        const uint8_t *palette=ASSET_DATA(ASSET_OVERWORLD_SPRITES_PALETTES(pal));
+        if(!palette || ASSET_SIZE(ASSET_OVERWORLD_SPRITES_PALETTES(pal))<32) FATAL("Redux battle sprite palette is unavailable\n");
+        unsigned position=4-count+i*2;
+        if(position>=7) continue;
+        int left=positions[position]+EB_VIEWPORT_PAD_LEFT+(HPPP_CENTER_TILE-16)*8-(int)wt*4;
+        for(unsigned column=0;column<wt*8;column++) {
+            unsigned sx=flip?wt*8-1-column:column;
+            const uint8_t *tile=frame+((unsigned)row/8*wt+sx/8)*32;
+            unsigned shift=7-(sx&7),line=(unsigned)(row&7)*2;
+            unsigned pixel=((tile[line]>>shift)&1)|(((tile[line+1]>>shift)&1)<<1)|
+                (((tile[line+16]>>shift)&1)<<2)|(((tile[line+17]>>shift)&1)<<3);
+            int x=left+(int)column;
+            if(pixel && x>=0 && x<width) {
+                colour[x]=bgr555_to_pixel(read_u16_le(palette+pixel*2));
+                priority[x]=4; wrote=true; /* BG3 text still has higher priority. */
+            }
+        }
+    }
+    return wrote;
+}
+
+bool maternalbound_battle_sprites_selftest(void) {
+    if(!maternalbound_enabled()) return false;
+    load_sprite_data();
+    unsigned variants=0;
+    for(unsigned mode=0;mode<3;mode++) {
+        game_state.character_mode=mode==0?CHARACTER_MODE_NORMAL:mode==1?CHARACTER_MODE_GHOST:CHARACTER_MODE_ROBOT;
+        for(unsigned c=1;c<=4;c++) {
+            unsigned w,h,p;bool flip;
+            if(!group_frame(character_group(c),&w,&h,&p,&flip)) return false;
+            variants++;
+        }
+    }
+    game_state.character_mode=0; game_state.player_controlled_party_count=4;
+    memset(&bt,0,sizeof(bt)); bt.battle_mode_flag=1;
+    for(unsigned i=0;i<4;i++) {bt.battlers_table[i].id=i+1;bt.battlers_table[i].consciousness=1;}
+    memset(&maternalbound_battle_sprites,0,sizeof(maternalbound_battle_sprites));
+    win.battle_menu_current_character_id=0;
+    for(unsigned i=0;i<8;i++) maternalbound_battle_sprites_tick();
+    if(maternalbound_battle_sprites.anchor_y[0]!=152 || maternalbound_battle_sprites.visible_mask!=1) return false;
+    win.battle_menu_current_character_id=3;
+    for(unsigned i=0;i<8;i++) maternalbound_battle_sprites_tick();
+    if(maternalbound_battle_sprites.anchor_y[3]!=152 || maternalbound_battle_sprites.visible_mask!=8) return false;
+    bt.battlers_table[1].consciousness=0;
+    maternalbound_battle_sprites_victory();
+    for(unsigned i=0;i<8;i++) maternalbound_battle_sprites_tick();
+    if(maternalbound_battle_sprites.visible_mask!=13) return false;
+    unsigned pixels=0;
+    for(int y=0;y<224;y++) {
+        uint16_t colour[384]={0};uint8_t priority[384]={0};
+        maternalbound_battle_sprites_line(y,colour,priority,384);
+        for(unsigned x=0;x<384;x++) pixels+=priority[x]!=0;
+    }
+    if(!pixels) return false;
+    bt.battle_mode_flag=0; maternalbound_battle_sprites_tick();
+    if(maternalbound_battle_sprites_visible() || maternalbound_battle_sprites.visible_mask) return false;
+    fprintf(stderr,"Redux native battle party sprites: %u variants, selection, victory, cleanup, %u pixels, PASS\n",variants,pixels);
+    return true;
+}
