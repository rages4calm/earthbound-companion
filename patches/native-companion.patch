diff --git a/src/tools/generate_constants_headers.py b/src/tools/generate_constants_headers.py
new file mode 100644
index 0000000..80a362c
--- /dev/null
+++ b/src/tools/generate_constants_headers.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Generate runtime-build numeric constants from checked-in assembly enums.
+
+Uses only Python's standard library. Diagnostic name arrays contain source
+symbols, not extracted in-game names. No ROM, game JSON or asset data is read
+or generated; the runtime pack still supplies all actual game records.
+"""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import re
+
+
+def read_enum(path: Path, enum_name: str, expected_count: int) -> list[tuple[str, int]]:
+    text = path.read_text(encoding='utf-8-sig')
+    active = False
+    found = False
+    ended = False
+    rows: list[tuple[str, int]] = []
+    for line_number, raw in enumerate(text.splitlines(), 1):
+        line = raw.split(';', 1)[0].strip()
+        if not active:
+            if line == '.ENUM ' + enum_name:
+                if found:
+                    raise ValueError(f'{path}:{line_number}: duplicate .ENUM {enum_name}')
+                found = active = True
+            continue
+        if line == '.ENDENUM':
+            active = False
+            ended = True
+            continue
+        if not line:
+            continue
+        match = re.fullmatch(r'([A-Z][A-Z0-9_]*)\s*=\s*(\$[0-9A-Fa-f]+|[0-9]+)', line)
+        if not match:
+            raise ValueError(f'{path}:{line_number}: expected an explicit numeric {enum_name} constant')
+        name, number = match.groups()
+        value = int(number[1:], 16) if number.startswith('$') else int(number, 10)
+        rows.append((name, value))
+    if not found or not ended or active:
+        raise ValueError(f'{path}: incomplete .ENUM {enum_name}')
+    if len(rows) != expected_count or [value for _, value in rows] != list(range(expected_count)):
+        raise ValueError(f'{path}: {enum_name} must explicitly contain IDs0..{expected_count - 1}')
+    if len({name for name, _ in rows}) != expected_count:
+        raise ValueError(f'{path}: duplicate {enum_name} symbol')
+    return rows
+
+
+def items_header(rows: list[tuple[str, int]]) -> str:
+    lines = [
+        '/* Generated from include/constants/items.asm; do not edit. */',
+        '#ifndef ITEMS_GENERATED_H', '#define ITEMS_GENERATED_H', '',
+        'enum ItemId {',
+    ]
+    lines.extend(f'    ITEM_{name} = 0x{value:02X},' for name, value in rows)
+    lines.extend(['};', '', f'#define ITEM_ID_COUNT {len(rows)}', '', '#ifdef ITEMS_INCLUDE_NAMES',
+                  '/* Diagnostic source symbols; game names come from the runtime pack. */',
+                  'static const char *ITEM_ID_NAMES[ITEM_ID_COUNT] = {'])
+    lines.extend(f'    [{value}] = "ITEM_{name}",' for name, value in rows)
+    lines.extend(['};', '#endif', '', '#endif /* ITEMS_GENERATED_H */', ''])
+    return '\n'.join(lines)
+
+
+def music_header(rows: list[tuple[str, int]]) -> str:
+    lines = [
+        '/* Generated from include/constants/music.asm; do not edit. */',
+        '#ifndef MUSIC_GENERATED_H', '#define MUSIC_GENERATED_H', '',
+    ]
+    lines.extend(f'#define MUSIC_{name:<38} {value}' for name, value in rows)
+    lines.extend(['', f'#define MUSIC_TRACK_COUNT {len(rows)}', '', '#ifdef MUSIC_INCLUDE_NAMES',
+                  '/* Diagnostic source symbols; game names come from the runtime pack. */',
+                  'static const char *MUSIC_TRACK_NAMES[MUSIC_TRACK_COUNT] = {'])
+    lines.extend(f'    [{value}] = "MUSIC_{name}",' for name, value in rows)
+    lines.extend(['};', '#endif', '', '#endif /* MUSIC_GENERATED_H */', ''])
+    return '\n'.join(lines)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--items-source', type=Path, required=True)
+    parser.add_argument('--music-source', type=Path, required=True)
+    parser.add_argument('--output-dir', type=Path, required=True)
+    args = parser.parse_args()
+    items = read_enum(args.items_source, 'ITEM', 254)
+    music = read_enum(args.music_source, 'MUSIC', 192)
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    for name, content in [('items_generated.h', items_header(items)), ('music_generated.h', music_header(music))]:
+        path = args.output_dir / name
+        encoded = content.encode('utf-8')
+        # Older generated headers can contain Windows CP1252 comments. Compare
+        # bytes so stale output is replaced without attempting to decode it.
+        if not path.exists() or path.read_bytes() != encoded:
+            path.write_bytes(encoded)
+    print(f'Generated numeric constants: {len(items)} items, {len(music)} music IDs')
+
+
+if __name__ == '__main__':
+    main()
