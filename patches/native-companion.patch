+#include <stdbool.h>
+#include <stdint.h>
+enum {
+    PC_A,
+    PC_B,
+    PC_X,
+    PC_Y,
+    PC_L,
+    PC_R,
+    PC_START,
+    PC_SELECT,
+    PC_UP,
+    PC_DOWN,
+    PC_LEFT,
+    PC_RIGHT,
+    PC_FAST,
+    PC_SAVE,
+    PC_LOAD,
+    PC_FULLSCREEN,
+    PC_PAUSE,
+    PC_SCREENSHOT,
+    PC_FPS,
+    PC_SETTINGS,
+    PC_ZOOM,
+    PC_ACTIONS
+};
+typedef struct {
+    int width, height, fullscreen, integer_scale, filter, companion;
+    _Atomic int volume, music_volume;
+    int instant_text, no_homesickness, no_dad_calls;
+    int exp_multiplier, money_multiplier, quick_slot, deadzone;
+    int keys[PC_ACTIONS], buttons[PC_ACTIONS];
+    char msu_dir[1024];
+} PcOptions;
+extern PcOptions pc_options;
+extern _Atomic bool pc_paused;
+extern const char *pc_config_path;
+extern const char *pc_input_script_path;
+void pc_options_defaults(void);
+bool pc_options_load(const char *path);
+void pc_video_apply(void);
+void pc_msu_command(uint8_t command);
+void pc_reload_if_requested(void);
+bool pc_input_selftest(void);
+bool pc_msu_selftest(void);
+#endif
