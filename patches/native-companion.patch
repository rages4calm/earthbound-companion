+bool pc_input_selftest(void) {
+    pc_options_defaults();
+    platform_input_init();
+    pc_options.keys[PC_L] = 4;
+    pc_options.keys[PC_A] = 4;
+    keys[4] = true;
+    assemble();
+    bool ok = (pad & (PAD_L | PAD_A)) == (PAD_L | PAD_A);
+    buttons[0] = true;
+    keys[4] = false;
+    assemble();
+    ok = ok && (pad & PAD_L) && !(pad & PAD_A);
+    buttons[0] = false;
+    axes[0] = 7000;
+    assemble();
+    ok = ok && !(pad & PAD_RIGHT);
+    axes[0] = 9000;
+    assemble();
+    ok = ok && (pad & PAD_RIGHT);
+    axes[0] = 0;
+    keys[pc_options.keys[PC_SAVE]] = true;
+    assemble();
+    ok = ok && (aux & AUX_SAVESTATE);
+    SDL_Event e;
+    memset(&e, 0, sizeof(e));
+    e.type = SDL_WINDOWEVENT;
+    e.window.event = SDL_WINDOWEVENT_FOCUS_LOST;
+    SDL_PushEvent(&e);
+    platform_input_poll();
+    ok = ok && pad == 0 && aux == 0;
+    platform_input_shutdown();
+    fprintf(stderr, "PC input remap / overlapping sources / deadzone / hotkey / focus-loss: %s\n",
+            ok ? "PASS" : "FAIL");
+    return ok;
+}
