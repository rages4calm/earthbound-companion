+     * Static/hidden/intangible party sprites must not spend stamina. */
+    bool moving=entity>=0 && entity<MAX_ENTITIES && !(entities.var[7][entity] & 0xFF00);
+    maternalbound_stamina_update(&ow.redux_primary_timer, &ow.redux_secondary_timer,
+                                (uint8_t)core.frame_counter, moving,
+                                (core.pad1_held & PAD_Y) != 0);
