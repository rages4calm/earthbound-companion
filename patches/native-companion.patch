+
+/* Redux's windows 53..61 overlap native PC settings IDs. Remap only IDs
+ * coming from converted scripts; native menus retain their own IDs. */
+uint16_t maternalbound_script_window(uint16_t id) {
+    return maternalbound_enabled() && id >= 53 && id <= 61 ? id + 11 : id;
+}
+
+bool maternalbound_window_config(uint16_t native_id, uint16_t out[4]) {
+    if (!maternalbound_enabled()) return false;
+    uint16_t id = native_id;
+    if (id >= 64 && id <= 72) id -= 11;
+    else if (id > 52 || id == WINDOW_COMMAND_MENU || id == WINDOW_FILE_SELECT_MAIN ||
+             id == WINDOW_FILE_SELECT_NAMING_BOX || (id >= 29 && id <= 35)) return false;
+    const uint8_t *p = ASSET_DATA(ASSET_US_GRAPHICS_TEXT_WINDOW_FLAVOUR_PALETTES_PAL);
+    size_t n = ASSET_SIZE(ASSET_US_GRAPHICS_TEXT_WINDOW_FLAVOUR_PALETTES_PAL);
+    if (!p || n < 464 || memcmp(p + 448,"MRWINX01",8) ||
+        read_u32_le(p + 456) != 62 || n != 464 + 62*8) return false;
+    for (unsigned i = 0; i < 4; i++) out[i] = read_u16_le(p + 464 + id*8 + i*2);
+    return out[2] >= 2 && out[3] >= 2 && out[0]+out[2] <= 32 && out[1]+out[3] <= 28;
+}
+void prepare_palette_fade_slopes(int16_t frames, uint16_t mask);
+void finalize_palette_fade(void);
+
+static const uint8_t *battle_art_container(unsigned *count,unsigned *palettes,unsigned *directory) {
+    const uint8_t *data=ASSET_DATA(ASSET_DATA_BATTLE_SPRITES_POINTERS_BIN);
+    size_t size=ASSET_SIZE(ASSET_DATA_BATTLE_SPRITES_POINTERS_BIN);
+    if(!data || size<16 || memcmp(data,"MRBSX001",8)) FATAL("Missing Redux battle art container\n");
+    *count=read_u16_le(data+8); *palettes=read_u16_le(data+10); *directory=read_u32_le(data+12);
+    if(!*count || *count>255 || !*palettes || *palettes>256 || *directory!=16+*count*5 ||
+       *directory>size || (*count+*palettes)*8>size-*directory) FATAL("Invalid Redux battle art directory\n");
+    return data;
+}
+
+const uint8_t *maternalbound_battle_art_table(unsigned *count) {
+    if(!maternalbound_enabled()) {
+        *count=(unsigned)(ASSET_SIZE(ASSET_DATA_BATTLE_SPRITES_POINTERS_BIN)/5);
+        return ASSET_DATA(ASSET_DATA_BATTLE_SPRITES_POINTERS_BIN);
+    }
+    unsigned palettes,directory;
+    return battle_art_container(count,&palettes,&directory)+16;
+}
+
+const uint8_t *maternalbound_battle_art_asset(bool palette,unsigned index,size_t *size) {
+    if(!maternalbound_enabled()) {
+        if(index>=(palette?32:110)) {*size=0;return NULL;}
+        unsigned id=palette?ASSET_BATTLE_SPRITES_PALETTES(index):ASSET_BATTLE_SPRITES(index);
+        *size=ASSET_SIZE(id);return ASSET_DATA(id);
+    }
+    unsigned count,palettes,directory;
+    const uint8_t *data=battle_art_container(&count,&palettes,&directory);
+    if(index>=(palette?palettes:count)) FATAL("Redux battle art index out of bounds\n");
+    const uint8_t *row=data+directory+((palette?count:0)+index)*8;
+    uint32_t offset=read_u32_le(row),bytes=read_u32_le(row+4);
+    size_t length=ASSET_SIZE(ASSET_DATA_BATTLE_SPRITES_POINTERS_BIN);
+    if(offset<directory+(count+palettes)*8 || offset>length || bytes>length-offset || (palette && bytes!=32))
+        FATAL("Redux battle art exceeds its container\n");
+    *size=bytes;return data+offset;
+}
+
+/* Adaptation of redux/six_letters.ccs (Vittorio, Chaz, D-Man). The retail
+ * character and save-block offsets stay intact; only the sixth letters use
+ * explicitly tagged spare save bytes. */
+unsigned maternalbound_name_capacity(void) { return maternalbound_enabled() ? 6 : 5; }
+
+uint8_t *maternalbound_character_name(unsigned index) {
+    static uint8_t names[TOTAL_PARTY_COUNT][7];
+    if (index >= TOTAL_PARTY_COUNT) FATAL("Invalid native character name index\n");
+    if (!maternalbound_enabled()) return party_characters[index].name;
+    memcpy(names[index],party_characters[index].name,5);
+    names[index][5]=index < 4 ? maternalbound_name_extra[index] : 0;
+    names[index][6]=0;
+    return names[index];
+}
+
+const uint8_t *maternalbound_character_name_of(const CharStruct *character) {
+    for (unsigned i=0;i<TOTAL_PARTY_COUNT;i++)
+        if (character == &party_characters[i]) return maternalbound_character_name(i);
+    FATAL("Character name is outside the native party table\n");
+    return NULL;
+}
+
+void maternalbound_set_character_name(unsigned index,const uint8_t *name,size_t length) {
+    uint8_t copy[7]={0};
+    if (index >= TOTAL_PARTY_COUNT || !name) FATAL("Invalid native character name target\n");
+    size_t capacity= index < 4 ? maternalbound_name_capacity() : 5;
+    if (length > capacity) length=capacity;
+    memcpy(copy,name,length);
+    memcpy(party_characters[index].name,copy,5);
+    if (index < 4) maternalbound_name_extra[index]=maternalbound_enabled() ? copy[5] : 0;
+}
+
+unsigned maternalbound_food_capacity(void) { return maternalbound_enabled() ? 10 : 6; }
+uint8_t *maternalbound_food_name(void) {
+    static uint8_t food[11];
+    if (!maternalbound_enabled()) return game_state.favourite_food;
+    memcpy(food,game_state.favourite_food,6);
+    memcpy(food+6,maternalbound_food_extra,4);food[10]=0;
+    return food;
+}
+void maternalbound_set_food_name(const uint8_t *name,size_t length) {
+    uint8_t copy[11]={0};
+    if (length > maternalbound_food_capacity()) length=maternalbound_food_capacity();
+    memcpy(copy,name,length);memcpy(game_state.favourite_food,copy,6);
+    if (maternalbound_enabled()) memcpy(maternalbound_food_extra,copy+6,4);
+    else memset(maternalbound_food_extra,0,4);
+}
+
+/* Native adaptation of redux/run_stamina_mechanic.ccs (Vittorio,
+ * SupremeKirb). Preserve its 8-bit wrapping and recovery latch timing. */
+void maternalbound_stamina_reset(void) {
+    ow.redux_primary_timer = 191;
+    ow.redux_secondary_timer = 143;
+}
+
+void maternalbound_stamina_update(uint8_t *primary, uint8_t *secondary,
+                                 uint8_t frame, bool moving, bool held) {
+    bool running = (*secondary & 0x80) && moving && held;
+    if (running) {
+        *primary = (uint8_t)((*primary & 0x7F)-1);
+        if (!*primary) *primary = 63;
+    } else if ((*secondary & 0x7F) != 15) {
+        if ((uint8_t)(frame << 1) == 0) *primary |= 0x80;
+        if (*primary & 0x80) {
+            ++*primary;
+            if ((*primary & 63) == 63) *primary &= 0x80;
+        }
+    }
+    if (running) {
+        if (!(*secondary & 0x7F)) *secondary = 120;
+        else if ((*primary & 63) == 1) --*secondary;
+    } else if ((*secondary & 0x7F) != 15 && !(*primary & 63)) {
+        ++*secondary;
+        if (*secondary == 128) *secondary = 143;
+    }
+}
+
+bool maternalbound_running(void) {
+    return (ow.redux_secondary_timer & 0x80) &&
+        (((core.pad1_held & PAD_Y) != 0) != event_flag_get(56));
+}
+
+void maternalbound_stamina_tick(void) {
+    if (!maternalbound_enabled()) return;
+    int16_t entity=ow.moving_party_member_entity_id;
+    /* Source reads the high byte of ENTITY_SCRIPT_VAR7_TABLE (7E1003).
+     * Static/hidden/intangible party sprites must not spend stamina. */
+    bool moving=entity>=0 && entity<MAX_ENTITIES && !(entities.var[7][entity] & 0xFF00);
+    maternalbound_stamina_update(&ow.redux_primary_timer, &ow.redux_secondary_timer,
+                                (uint8_t)core.frame_counter, moving,
+                                (core.pad1_held & PAD_Y) != 0);
+    if (maternalbound_running()) event_flag_set(65);
+    else event_flag_clear(65);
+}
+
+bool maternalbound_stamina_selftest(void) {
+    uint8_t primary=191, secondary=143;
+    unsigned spent=0;
+    while ((secondary & 0x80) && spent < 1100) {
+        maternalbound_stamina_update(&primary,&secondary,(uint8_t)spent,true,true);
+        ++spent;
+    }
+    bool ok = spent == 945 && secondary == 120;
+    unsigned recovered=0;
+    while (secondary != 143 && recovered < 1000) {
+        maternalbound_stamina_update(&primary,&secondary,(uint8_t)(spent+recovered),true,true);
+        ++recovered;
+    }
+    ok &= recovered > 440 && recovered < 640;
+    primary=191;secondary=143;
+    for (unsigned i=0;i<2000;i++) maternalbound_stamina_update(&primary,&secondary,(uint8_t)i,false,true);
+    ok &= primary==191 && secondary==143;
+    primary=20;secondary=140;
+    maternalbound_stamina_update(&primary,&secondary,1,true,false);
+    ok &= primary==20 && secondary==140;
+    maternalbound_stamina_update(&primary,&secondary,128,true,false);
+    ok &= primary==149 && secondary==140;
+    fprintf(stderr,"Redux stamina depletion/recovery checks: %s (%u/%u frames)\n",ok?"PASS":"FAIL",spent,recovered);
+    return ok;
+}
+
+/* Source: essential/fade_tools.ccs. Preserve the full final palette copy,
+ * including the source's treatment of groups outside the interpolation mask. */
+void maternalbound_palette_fade_start(bool inward, uint16_t colour, uint16_t mask, uint16_t duration) {
+    PaletteFadeBuffer *fade = buf_palette_fade(ert.buffer);
+    for (unsigned i=0;i<256;i++) {
+        fade->target[i] = inward ? ert.palettes[i] : colour;
+        if (inward) ert.palettes[i] = colour;
+    }
+    prepare_palette_fade_slopes((int16_t)duration,mask);
+    ert.palette_upload_mode = PALETTE_UPLOAD_FULL;
+    if (!duration) finalize_palette_fade();
+}
+
+/* Source: essential/cc_effects.ccs. The opening loop renders 0,3,...,39;
+ * the closing loop renders 39,36,...,3 and then disables HDMA. */
+void maternalbound_letterbox_start(uint8_t routine) {
+    ow.redux_letterbox_active = 1;
+    ow.redux_letterbox_direction = routine == 11 ? 1 : routine == 13 ? 2 : 0;
+    ow.redux_letterbox_top = routine == 11 ? 0 : routine == 13 ? 39 : 40;
+}
+
+void maternalbound_effects_tick(void) {
+    if (!maternalbound_enabled() || !ow.redux_letterbox_active) return;
+    if (ow.redux_letterbox_direction == 2 && !ow.redux_letterbox_top) {
+        ow.redux_letterbox_active = 0; ow.redux_letterbox_direction = 0;
+        ppu.tm_hdma_active = false;
+        return;
+    }
+    bt.letterbox_top_end = ow.redux_letterbox_top;
+    bt.letterbox_bottom_start = 224-ow.redux_letterbox_top;
+    bt.letterbox_nonvisible_screen_value = 4; /* BG3, the black bars */
+    bt.letterbox_visible_screen_value = 23; /* BG1/BG2/BG3/objects */
+    build_letterbox_hdma_table();
+    apply_letterbox_to_ppu();
+    if (ow.redux_letterbox_direction == 1) {
+        if (ow.redux_letterbox_top < 39) ow.redux_letterbox_top += 3;
+        else ow.redux_letterbox_direction = 0;
+    } else if (ow.redux_letterbox_direction == 2) {
+        if (ow.redux_letterbox_top > 3) ow.redux_letterbox_top -= 3;
+        else ow.redux_letterbox_top = 0; /* Disable only after the frame at 3 was rendered. */
+    }
+}
+
+static const uint8_t *redux_blob;
+static uint32_t redux_map_offset, redux_map_count, redux_determiner_offset, redux_determiner_size;
+
+static uint32_t redux_u32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+uint32_t maternalbound_enemy_ai_entry(uint16_t enemy) {
+    if (!maternalbound_enabled()) return 0;
+    const uint8_t *table = ASSET_DATA(ASSET_DATA_ENEMY_CONFIGURATION_TABLE_BIN);
+    size_t size = ASSET_SIZE(ASSET_DATA_ENEMY_CONFIGURATION_TABLE_BIN);
+    const size_t records = 231, offset = records*sizeof(EnemyData);
+    if (!table || size != offset+12+records*4 ||
+        memcmp(table+offset,"MRDXAI01",8) || read_u32_le(table+offset+8) != records)
+        FATAL("Redux: invalid native enemy AI table\n");
+    return enemy < records ? read_u32_le(table+offset+12+enemy*4) : 0;
+}
+
+uint16_t maternalbound_sprite_variant(unsigned character,unsigned mode,bool running,bool alternate) {
+    const uint8_t *data=ASSET_DATA(ASSET_DATA_PLAYABLE_CHARACTER_GRAPHICS_TABLE_BIN);
+    size_t size=ASSET_SIZE(ASSET_DATA_PLAYABLE_CHARACTER_GRAPHICS_TABLE_BIN);
+    if (character>=17 || mode>=8 || !maternalbound_enabled()) return 0xFFFF;
+    if (!data || size!=272+8+3*272 || memcmp(data+272,"MRWALK01",8))
+        FATAL("Redux: invalid native walking animation tables\n");
+    unsigned variant=running ? (alternate ? 3 : 2) : (alternate ? 1 : 0);
+    size_t base=variant ? 280+(variant-1)*272 : 0;
+    return read_u16_le(data+base+(character*8+mode)*2);
+}
+
+bool maternalbound_bind_dialogue(const uint8_t *blob, size_t size) {
+    redux_blob = NULL;
+    if (!blob) return false;
+    if (size < 32 || memcmp(blob + size - 32, "MRDXNV01", 8))
+        return size < MATERNALBOUND_DIALOGUE_BASE-0x100000u;
+    const uint8_t *footer = blob + size - 32;
+    uint32_t version = redux_u32(footer + 8);
+    uint32_t map = redux_u32(footer + 12), count = redux_u32(footer + 16);
+    uint32_t determiners = redux_u32(footer + 20), determiner_size = redux_u32(footer + 24);
+    uint32_t dialogue_end = redux_u32(footer + 28);
+    if ((version != 1 && version != 2) || !count || count > (version==1 ? 10000u : 1000000u) || map > size-32 || (uint64_t)map + count*8u > size-32 ||
+        determiners > size-32 || (uint64_t)determiners + determiner_size > size-32 ||
+        dialogue_end < MATERNALBOUND_DIALOGUE_BASE-0x100000u || dialogue_end != map || determiner_size != 254 ||
+        (uint64_t)map + count*8u != determiners || (uint64_t)determiners + determiner_size != size-32)
+        return false;
+    uint32_t previous = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t source = redux_u32(blob + map + i*8u);
+        uint32_t target = redux_u32(blob + map + i*8u + 4);
+        bool source_valid=(source>=0x100000u && source<MATERNALBOUND_DIALOGUE_BASE) ||
+            (version==2 && source>=0xC00000u && source<=0xFFFFFFu);
+        if (!source_valid || source <= previous ||
+            target < MATERNALBOUND_DIALOGUE_BASE || target-0x100000u >= dialogue_end) return false;
+        previous = source;
+    }
+    for (uint32_t i = 0; i < determiner_size; ++i)
+        if (blob[determiners+i] < 1 || blob[determiners+i] > 5) return false;
+    redux_blob = blob; redux_map_offset = map; redux_map_count = count;
+    redux_determiner_offset = determiners; redux_determiner_size = determiner_size;
+    return true;
+}
+
+static void redux_put_u32(uint8_t *p, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i) p[i] = (uint8_t)(value >> (i*8));
+}
+
+bool maternalbound_asset_selftest(const uint8_t *restore, size_t restore_size) {
+    size_t map = MATERNALBOUND_DIALOGUE_BASE-0x100000u+16;
+    size_t determiners = map+16, size = determiners+254+32;
+    uint8_t *blob = calloc(size, 1);
+    if (!blob) return false;
+    uint8_t *footer = blob+size-32;
+    memcpy(footer, "MRDXNV01", 8);
+    redux_put_u32(footer+8,1); redux_put_u32(footer+12,(uint32_t)map);
+    redux_put_u32(footer+16,2); redux_put_u32(footer+20,(uint32_t)determiners);
+    redux_put_u32(footer+24,254); redux_put_u32(footer+28,(uint32_t)map);
+    redux_put_u32(blob+map,0x100040); redux_put_u32(blob+map+4,0x300000);
+    redux_put_u32(blob+map+8,0x100080); redux_put_u32(blob+map+12,0x300008);
+    memset(blob+determiners,5,254); blob[determiners+42] = 2;
+    bool ok = maternalbound_bind_dialogue(blob,size) && maternalbound_enabled() &&
+        maternalbound_resolve_entry(0x100040) == 0x300000 && maternalbound_resolve_entry(0x100080) == 0x300008 &&
+        maternalbound_resolve_entry(0x100041) == 0 && maternalbound_resolve_entry(0x300007) == 0x300007 &&
+        maternalbound_item_determiner(42,0) == 2 && maternalbound_item_determiner(0,42) == 2 &&
+        maternalbound_item_determiner(UINT32_MAX,0) == 5;
+    const struct {size_t offset; uint32_t value;} bad[] = {
+        {size-24,3}, {size-20,UINT32_MAX}, {size-16,10001}, {size-16,0},
+        {size-12,(uint32_t)map}, {size-8,255}, {size-4,(uint32_t)map+1},
+        {map+8,0x100040}, {map+4,0x100000}, {map+4,0x300010}
+    };
+    for (unsigned i = 0; i < sizeof(bad)/sizeof(bad[0]); ++i) {
+        uint32_t saved = redux_u32(blob+bad[i].offset);
+        redux_put_u32(blob+bad[i].offset,bad[i].value);
+        ok &= !maternalbound_bind_dialogue(blob,size) && !maternalbound_enabled();
+        redux_put_u32(blob+bad[i].offset,saved);
+    }
+    blob[determiners+42] = 0;
+    ok &= !maternalbound_bind_dialogue(blob,size);
+    blob[determiners+42] = 2;
+    redux_put_u32(footer+8,2);
+    redux_put_u32(blob+map,0xC70040);
+    redux_put_u32(blob+map+8,0xF90008);
+    ok &= maternalbound_bind_dialogue(blob,size) &&
+        maternalbound_resolve_entry(0xC70040)==0x300000 &&
+        maternalbound_resolve_entry(0xF90008)==0x300008 &&
+        maternalbound_resolve_entry(0xC70041)==0 &&
+        maternalbound_resolve_entry(0x300003)==0x300003;
+    redux_put_u32(footer+8,1);
+    ok &= !maternalbound_bind_dialogue(blob,size);
+    redux_put_u32(footer+8,2);
+    redux_put_u32(blob+map+8,0x1000000);
+    ok &= !maternalbound_bind_dialogue(blob,size);
+    redux_put_u32(blob+map+8,0x800000);
+    ok &= !maternalbound_bind_dialogue(blob,size);
+    footer[0] = 'X'; ok &= !maternalbound_bind_dialogue(blob,size);
+    ok &= maternalbound_bind_dialogue(restore,restore_size);
+    free(blob);
+    fprintf(stderr,"Redux asset entry mapping / malformed metadata checks: %s\n",ok?"PASS":"FAIL");
+    return ok;
+}
+
+bool maternalbound_enabled(void) { return redux_blob != NULL; }
+
+uint32_t maternalbound_resolve_entry(uint32_t address) {
+    if (!redux_blob || address < 0x100000u ||
+        (address>=MATERNALBOUND_DIALOGUE_BASE && address<0xC00000u)) return address;
+    uint32_t lo = 0, hi = redux_map_count;
+    while (lo < hi) {
+        uint32_t middle = lo + (hi-lo)/2;
+        uint32_t key = redux_u32(redux_blob + redux_map_offset + middle*8u);
+        if (key < address) lo = middle+1;
+        else hi = middle;
+    }
+    if (lo < redux_map_count && redux_u32(redux_blob + redux_map_offset + lo*8u) == address)
+        return redux_u32(redux_blob + redux_map_offset + lo*8u + 4);
+    return 0; /* never silently mix an unmapped original-story script into Redux */
+}
+
+uint32_t maternalbound_item_determiner(uint32_t item, uint32_t argument) {
+    uint32_t wanted = item ? item : argument;
+    if (!redux_blob || wanted >= redux_determiner_size) return 5; /* no determiner */
+    return redux_blob[redux_determiner_offset+wanted];
+}
+
+/* Source: Redux bugfixes/try_give_money.ccs and try_deposit_money.ccs.
+ * 1A18 commits only if the complete gift fits; 1A19 and 1A1A query without
+ * changing either balance. Zero operands use the argument register. */
+bool maternalbound_money(uint8_t command, uint32_t operand, uint32_t argument,
+                        uint32_t balance, uint32_t *new_balance, uint32_t *result) {
+    if (!new_balance || !result || (command != 0x18 && command != 0x19 && command != 0x1A))
+        return false;
+    uint32_t amount = operand ? operand : argument;
+    uint32_t limit = command == 0x1A ? 9999999u : 99999u;
+    uint64_t total = (uint64_t)balance + amount;
+    uint64_t excess = total > limit ? total - limit : 0;
+    /* Never let a wrapped result report success for an oversized gift. */
+    *result = excess > UINT32_MAX ? UINT32_MAX : (uint32_t)excess;
+    *new_balance = command == 0x18 && !excess ? (uint32_t)total : balance;
+    return true;
+}
+
+/* Source: essential/cc_char_in_party.ccs. Includes NPCs and current ordering. */
+uint32_t maternalbound_party_position(const uint8_t *order, size_t count,
+                                     uint32_t character, uint32_t argument) {
+    uint32_t wanted = character ? character : argument;
+    if (!order || !wanted || wanted > UINT8_MAX) return 0;
+    for (size_t i = 0; i < count; ++i)
+        if (order[i] == wanted) return (uint32_t)i + 1;
+    return 0;
+}
+
+/* Source: redux/goods_menu_equip.ccs CompareResToArg, both 16-bit words. */
+uint32_t maternalbound_registers_equal(uint32_t result, uint32_t argument) {
+    return result == argument ? 1u : 0u;
+}
