+static void assemble(void) {
+    pad = aux = 0;
+    for (int i = 0; i < PC_ACTIONS; i++) {
+        int k = pc_options.keys[i], b = pc_options.buttons[i];
+        if (engine_alt_controls == ALT_CONTROLS_ON && b >= 0 && b < 4)
+            b ^= 1;
+        bool held = (k > 0 && k < SDL_NUM_SCANCODES && keys[k]) || (b >= 0 && b < 21 && buttons[b]);
+        bool pressed = held && !last[i];
+        last[i] = held;
+        if (i < 12 && held)
+            pad |= bits[i];
+        if (i == PC_FAST && held)
+            aux |= AUX_FAST_FORWARD;
+        if (i == PC_SAVE && held)
+            aux |= AUX_SAVESTATE;
+        if (i == PC_LOAD && held)
+            aux |= AUX_LOAD_STATE;
+        if (i == PC_FPS && held)
+            aux |= AUX_FPS_TOGGLE;
+        if (i == PC_ZOOM && held)
+            aux |= AUX_ZOOM_TOGGLE;
+        if (i == PC_FULLSCREEN && pressed) {
+            pc_options.fullscreen = !pc_options.fullscreen;
+            pc_video_apply();
+        }
+        if (i == PC_PAUSE && pressed)
+            pc_paused = !pc_paused;
+        if (i == PC_SCREENSHOT && pressed) {
+            char p[128];
+            snprintf(p, sizeof(p), "screenshots/earthbound-%llu.bmp",
+                     (unsigned long long)SDL_GetTicks64());
+            platform_video_request_screenshot(p);
+        }
+        if (i == PC_SETTINGS && pressed) {
+            pc_paused = true;
+            FILE *f = fopen("settings.request", "wb");
+            if (f)
+                fclose(f);
+        }
     }
+    if (axes[0] < -pc_options.deadzone)
+        pad |= PAD_LEFT;
+    if (axes[0] > pc_options.deadzone)
+        pad |= PAD_RIGHT;
+    if (axes[1] < -pc_options.deadzone)
+        pad |= PAD_UP;
+    if (axes[1] > pc_options.deadzone)
+        pad |= PAD_DOWN;
 }
