+bool maternalbound_equipment_selftest(void) {
+    if (!maternalbound_enabled()) return false;
+    unsigned tests=0;
+    for (unsigned char_id=1; char_id<=4; char_id++) {
+        CharStruct *ch=&party_characters[char_id-1];
+        CharStruct original=*ch;
+        memset(ch,0,sizeof(*ch));
+        ch->base_offense=80; ch->base_defense=70; ch->base_speed=30;
+        ch->base_guts=20; ch->base_luck=40;
+        ch->boosted_speed=7; ch->boosted_luck=9; ch->boosted_guts=3;
+        for (unsigned item=1; item<ITEM_CONFIG_COUNT; item++) {
+            const ItemConfig *entry=get_item_entry(item);
+            if (!entry) continue;
+            if (get_item_type(item)!=2) {
+                ch->items[13]=item;
+                CharStruct before=*ch;
+                (void)equip_item(char_id,14);
+                if (memcmp(ch,&before,sizeof(before))) return false;
+                continue;
+            }
+            unsigned type=entry->type & EQUIP_TYPE_MASK;
+            unsigned slot;
+            switch (type) {
+            case EQUIP_TYPE_WEAPON: slot=EQUIP_WEAPON; break;
+            case EQUIP_TYPE_BODY: slot=EQUIP_BODY; break;
+            case EQUIP_TYPE_ARMS: slot=EQUIP_ARMS; break;
+            case EQUIP_TYPE_OTHER: slot=EQUIP_OTHER; break;
+            default: continue;
+            }
+            memset(ch->items,0,sizeof(ch->items)); memset(ch->equipment,0,4);
+            ch->items[13]=item;
+            recalc_character_postmath_offense(char_id); recalc_character_postmath_defense(char_id);
+            recalc_character_postmath_speed(char_id); recalc_character_postmath_guts(char_id);
+            recalc_character_postmath_luck(char_id); calc_resistances(char_id);
+            uint8_t slots[4]={0}, stats[5], resist[6]; slots[slot]=14;
+            CharStruct before=*ch;
+            if (!equipment_snapshot(char_id,slots,stats,resist) || memcmp(ch,&before,sizeof(before))) return false;
+            (void)equip_item(char_id,14);
+            if (ch->equipment[slot]!=14 || stats[0]!=ch->offense || stats[1]!=ch->defense ||
+                stats[2]!=ch->speed || stats[3]!=ch->guts || stats[4]!=ch->luck ||
+                resist[0]!=ch->fire_resist || resist[1]!=ch->freeze_resist ||
+                resist[2]!=ch->flash_resist || resist[3]!=ch->paralysis_resist ||
+                resist[4]!=ch->hypnosis_brainshock_resist || resist[5]!=3-resist[4]) {
+                fprintf(stderr,"Redux equipment preview failed: character %u, item %u, type %u\n",char_id,item,type);
+                return false;
+            }
+            // A removed bear shifts the selected weapon; a second unrelated
+            // item must never become equipped in its place.
+            if (resolve_battle_equipment_slot(char_id,14,item)!=14) return false;
+            ch->items[13]=0; ch->items[12]=item;
+            if (resolve_battle_equipment_slot(char_id,14,item)!=13) return false;
+            ch->items[12]=0;
+            if (resolve_battle_equipment_slot(char_id,14,item) || resolve_battle_equipment_slot(char_id,0,item)) return false;
+            tests++;
