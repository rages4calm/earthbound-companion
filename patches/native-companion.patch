+/* Catador's teleport_hardlock_fix. Run at the completed actionscript-frame
+ * boundary, so removing an NPC also releases its script and sprite storage
+ * without invalidating the scheduler currently walking the active list. */
+static unsigned teleport_despawn_distant_entities(void) {
+    int16_t saved = ert.current_entity_slot;
+    unsigned removed = 0;
+    for (int16_t slot = INIT_ENTITY_SLOT-1; slot >= 0; --slot) {
+        if (entities.sprite_ids[slot] < 0 || entities.script_table[slot]==ENTITY_NONE) continue;
+        ert.current_entity_slot = slot;
+        uint16_t pc;
+        if (!cr_is_entity_near_leader(slot,0,0,&pc)) {
+            remove_entity(slot);
+            ++removed;
+        }
+    }
+    ert.current_entity_slot = saved;
+    return removed;
+}
+
+bool maternalbound_teleport_selftest(void) {
+    if (!maternalbound_enabled()) return false;
+    load_sprite_data();
+    entity_system_init();
+    memset(entities.sprite_ids,0xFF,sizeof(entities.sprite_ids));
+    game_state.leader_x_coord=1000; game_state.leader_y_coord=1000;
+    if (create_entity(1,EVENT_SCRIPT_002,0,1000,1000)!=0 ||
+        create_entity(1,EVENT_SCRIPT_002,INIT_ENTITY_SLOT,3000,3000)!=INIT_ENTITY_SLOT)
+        return false;
+    ert.current_entity_slot=INIT_ENTITY_SLOT;
+    ow.psi_teleport_speed=0xA0000;
+    /* Repeated removal/recreation catches leaking script slots or sprite
+     * allocations, as well as retaining the old fast-teleport exemption. */
+    for (unsigned i=0;i<128;i++) {
+        if (create_entity(1,EVENT_SCRIPT_002,1,3000,3000)!=1 ||
+            teleport_despawn_distant_entities()!=1 ||
+            ert.current_entity_slot!=INIT_ENTITY_SLOT ||
+            entities.script_table[1]!=ENTITY_NONE || entities.sprite_ids[1]!=-1 ||
+            entities.script_table[0]==ENTITY_NONE ||
+            entities.script_table[INIT_ENTITY_SLOT]==ENTITY_NONE) return false;
+    }
+    ModeState state={0};state.teleport.phase=TP_CLEANUP;
+    for (unsigned enabled=0;enabled<2;enabled++) {
+        state.teleport.redux_saved_enemy_spawns=enabled;
+        ow.enemy_spawns_enabled=0;
+        StepResult result=mode_step_teleport(&state);
+        if (result.kind!=STEP_POP || ow.enemy_spawns_enabled!=enabled) return false;
+    }
+    fprintf(stderr,"Redux native teleport: 128 distant-NPC allocation cycles, protected entities, spawn restoration, PASS\n");
+    return true;
+}
