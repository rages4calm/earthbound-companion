diff --git a/src/game/window.c b/src/game/window.c
index 39d48a0e..03c2a839 100644
--- a/src/game/window.c
+++ b/src/game/window.c
@@ -542,6 +542,29 @@ WindowInfo *get_window(uint16_t window_id) {
     return NULL;
 }
 
+/* Companion: the command menu is taller than the ROM's (extra Keys/Save/
+ * Set Up/Quit rows) and the carried-money window always draws beneath every
+ * other window, so its ROM position ends up hidden behind the menu. While
+ * both are open, sit the money window directly below the menu instead;
+ * otherwise use its configured position. */
+void place_money_window(void) {
+    WindowInfo *m = get_window(WINDOW_CARRIED_MONEY);
+    if (!m) return;
+    uint16_t cfg[4];
+    uint16_t y = maternalbound_window_config(WINDOW_CARRIED_MONEY, cfg)
+                 ? cfg[1] : window_configs[WINDOW_CARRIED_MONEY][1];
+    const WindowInfo *c = get_window(WINDOW_COMMAND_MENU);
+    if (c && m->x < c->x + c->width && c->x < m->x + m->width &&
+        y < c->y + c->height && c->y < y + m->height &&
+        c->y + c->height + m->height <= 28)
+        y = c->y + c->height;
+    if (m->y != y) {
+        m->y = y;
+        m->content_y = y + 1;
+        ow.redraw_all_windows = 1;
+    }
+}
