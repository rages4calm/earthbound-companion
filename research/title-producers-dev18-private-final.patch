+/* Window titles keep their existing byte-string/save layout. Preserve raw
+ * EB glyphs that have no ASCII spelling as high-bit bytes; ordinary ASCII
+ * titles retain their original representation. Only the tiny-title renderer
+ * consumes this encoding, so general text/menu ASCII conversion is unchanged. */
+char eb_char_to_title_byte(uint8_t eb_char) {
+    char ascii = eb_char_to_ascii(eb_char);
+    if (ascii_to_eb_char(ascii) == eb_char) return ascii;
+    if (eb_char >= 0x80) return (char)eb_char;
+    return ascii; /* retain the existing fallback for invalid/control bytes */
+}
+
+int eb_to_title_buf(const uint8_t *src, int max_len, char *dst, int capacity) {
+    int copied = 0;
+    if (!dst || capacity <= 0) return 0;
+    if (src) {
+        for (int i = 0; i < max_len && src[i] && copied + 1 < capacity; i++)
+            dst[copied++] = eb_char_to_title_byte(src[i]);
+    }
+    dst[copied] = '\0';
+    return copied;
+}
+
+uint8_t title_byte_to_eb_char(char title_byte) {
+    uint8_t byte = (uint8_t)title_byte;
+    return byte >= 0x80 ? byte : ascii_to_eb_char(title_byte);
+}
