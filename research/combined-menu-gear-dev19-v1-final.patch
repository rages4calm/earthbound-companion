+/* Both source party selectors populate only these normal-font windows with
+ * raw character names, at x=i*6 and userdata=party member ID. The window/id
+ * contract also identifies restored labels without changing MenuItem or F6.
+ * Other menus, dialogue and right labels keep their existing ASCII decoding;
+ * the HPPP Give picker uses its separate raw-name renderer. */
+static bool menu_item_is_party_name(const WindowInfo *w, const MenuItem *item) {
+    bool name_window = w->id == WINDOW_SINGLE_CHARACTER_SELECT ||
+        (w->id >= WINDOW_TARGETING_PROMPT + 1 &&
+         w->id <= WINDOW_TARGETING_PROMPT + 3);
+    return name_window && ((item->userdata >= PARTY_MEMBER_NESS &&
+                           item->userdata <= PARTY_MEMBER_POO) ||
+                          item->userdata == PARTY_MEMBER_KING);
+}
+
+static bool menu_item_has_name_glyphs(const WindowInfo *w, const MenuItem *item) {
+    return menu_item_is_file_slot(w, item) || menu_item_is_party_name(w, item);
+}
